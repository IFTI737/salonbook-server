# HOW TO USE: copy this file to a new file named .env and replace every value.
# Never commit .env (it is git-ignored).

# Port the API listens on locally (Vercel ignores this)
PORT=5000

# 1) MongoDB Atlas connection string. Use the SAME one as the client.
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# 2) The address of the client app, used for CORS and to check login tokens.
#    Local: http://localhost:3000
#    On Vercel: your live client URL, with no trailing slash.
CLIENT_URL=http://localhost:3000

# 3) Stripe (test mode). Get both from the Stripe dashboard.
#    Secret key: Developers > API keys (starts with sk_test_)
STRIPE_SECRET_KEY=
#    Webhook signing secret: Developers > Webhooks > your endpoint > Signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
