# Copy this file to .env and fill in real values.
# Never commit .env (it is git-ignored).

# Port the API listens on (default: 5000)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Frontend URL. Used for CORS and to verify the Better Auth JWT.
# On Vercel this must be the exact live client URL (no trailing slash).
CLIENT_URL=http://localhost:3000
